generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  cpf              String       @unique
  email            String       @unique
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             UserRoleEnum @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[] @relation(name: "user")
  taskUpdates Task[] @relation(name: "updatedBy")

  @@map("users")
}

model Task {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  service     String         @default("Não informado")
  status      TaskStatusEnum @default(OPEN)
  files       String[]       @default([])
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  updatedBy   User?   @relation(fields: [updatedById], references: [id], name: "updatedBy", onDelete: SetNull)
  updatedById String? @db.ObjectId

  user   User   @relation(fields: [userId], references: [id], name: "user", onDelete: Cascade)
  userId String @db.ObjectId

  @@map("tasks")
}

enum UserRoleEnum {
  ADMIN
  USER
  GESTOR
}

enum TaskStatusEnum {
  OPEN
  CLOSED
  EXPIRED
}
