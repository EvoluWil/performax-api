generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  cpf              String    @unique
  email            String    @unique
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employees Employee[]
  companies Company[]  @relation(name: "Owner")

  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.ObjectId

  @@map("users")
}

model Profile {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  nationality      String
  homeState        String
  homeCity         String
  socialName       String
  birthdate        DateTime
  matherName       String
  fatherName       String
  gender           GenderEnum
  ethnicity        EthnicityEnum        @default(NONE)
  maritalStatus    MaritalStatusEnum
  biologicalGender BiologicalGenderEnum
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isPwd            Boolean              @default(false)

  user       User[]
  address    ProfileAddress[]
  educations ProfileEducation[]
  contacts   ProfileContact[]

  @@map("profiles")
}

model ProfileEducation {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  level       EducationLevel
  institution String
  course      String
  endDate     DateTime
  proof       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.ObjectId

  @@map("profileEducations")
}

model ProfileAddress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  street       String
  streetNumber String?
  complement   String?
  district     String?
  city         String
  state        String
  zipCode      String
  proof        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.ObjectId

  @@map("profileAddresses")
}

model ProfileContact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.ObjectId

  @@map("profileContacts")
}

model Company {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cnpj          String   @unique
  name          String
  fantasyName   String?
  address       String
  state         String
  city          String
  addressNumber String?
  zipCode       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sectors  Sector[]
  benefits Benefit[]

  owner   User   @relation(fields: [ownerId], references: [id], name: "Owner")
  ownerId String @db.ObjectId

  partners            Partner[]
  financials          Financial[]
  financialCategories FinancialCategory[]
  financialContracts  FinancialContract[]

  @@map("companies")
}

model Sector {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("sectors")
}

model Role {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  sector   Sector @relation(fields: [sectorId], references: [id])
  sectorId String @db.ObjectId

  @@map("roles")
}

model Employee {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  salary              Float
  admission           DateTime
  accessLevel         AccessLevelEnum  @default(COMUM)
  contractType        ContractTypeEnum
  attendanceLocations String[]         @default([])

  documents   EmployeeDocument[]
  vacations   EmployeeVacation[]
  attendances EmployeeAttendance[]
  dependents  EmployeeDependent[]

  bankInfo   EmployeeBankInfo? @relation(fields: [bankInfoId], references: [id])
  bankInfoId String?           @db.ObjectId

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  benefits   Benefit[] @relation(fields: [benefitsId], references: [id])
  benefitsId String[]  @default([]) @db.ObjectId

  manager   Employee? @relation(name: "ManagerEmployee", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  managerId String?   @db.ObjectId

  managedEmployees Employee[] @relation("ManagerEmployee")

  @@map("employees")
}

model EmployeeDocument {
  id        String                   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  proof     String
  type      EmployeeDocumentTypeEnum
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.ObjectId

  @@map("employeeDocuments")
}

model EmployeeBankInfo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bank      Int
  agency    Int
  account   Int
  pix       String
  proof     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee[]

  @@map("employeeBankInfos")
}

model EmployeeVacation {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  startDate DateTime
  endDate   DateTime
  obs       String?
  status    VacationStatusEnum @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId

  @@map("employeeVacations")
}

model EmployeeAttendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  location  String
  proof     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("employeeAttendances")
}

model EmployeeDependent {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  cpf        String
  matherName String
  birthDate  DateTime
  proof      String
  kinship    KinshipEnum
  isPwd      Boolean     @default(false)
  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId

  benefits   Benefit[] @relation(fields: [benefitsId], references: [id])
  benefitsId String[]  @default([]) @db.ObjectId

  @@map("employeeDependents")
}

model Benefit {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  description        String
  valueForEmployee   Float
  valueForDependents Float    @default(0)
  valueForCompany    Float
  isValuePerEmployee Boolean
  isDependents       Boolean
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employees   Employee[] @relation(fields: [employeesId], references: [id])
  employeesId String[]   @default([]) @db.ObjectId

  dependents   EmployeeDependent[] @relation(fields: [dependentsId], references: [id])
  dependentsId String[]            @default([]) @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("benefits")
}

model Partner {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String?
  document  String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  type      PartnerTypeEnum

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  financials Financial[]

  @@map("partners")
}

model Financial {
  id          String                      @id @default(auto()) @map("_id") @db.ObjectId
  description String
  value       String
  startDate   DateTime
  endDate     DateTime?
  observation String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  type        FinancialTypeEnum
  recurrence  FinancialRecurrenceTypeEnum

  partner   Partner @relation(fields: [partnerId], references: [id])
  partnerId String  @db.ObjectId

  category   FinancialCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?            @db.ObjectId

  contract   FinancialContract? @relation(fields: [contractId], references: [id])
  contractId String?            @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("financials")
}

model FinancialCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  financials Financial[]

  @@map("financialCategories")
}

model FinancialContract {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  financials Financial[]

  @@map("financialContracts")
}

enum EthnicityEnum {
  BROWN
  INDIGENOUS
  WHITE
  BLACK
  YELLOW
  NONE
}

enum GenderEnum {
  MAN
  WOMAN
  TRANS_WOMAN
  TRANS_MAN
  TRANSVESTITE
  TRANSSEXUAL
  QUEER
  NON_BINARY
  GENDER_FLUID
  TRANSGENDER
  OTHERS
}

enum BiologicalGenderEnum {
  MAN
  WOMAN
}

enum MaritalStatusEnum {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWER
  SEPARATED
  OTHERS
}

enum ContractTypeEnum {
  CLT
  PJ
  TEMPORARY
  INTERNSHIP
  OTHERS
}

enum KinshipEnum {
  SPOUSE
  PARTNER
  SON
  PARENTS
  GRANDPARENTS
  AGGREGATE
  EX_SPOUSE
}

enum AccessLevelEnum {
  COMUM
  ADMIN
  FINANCIAL
  RH
}

enum EmployeeDocumentTypeEnum {
  CONTRACT
  PAYSLIP
  PERSONAL
}

enum EducationLevel {
  PRIMARY
  SECONDARY
  GRADUATION
  TECHNIC
  OTHER
}

enum VacationStatusEnum {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  COMPLETED
}

enum PartnerTypeEnum {
  SUPPLIER
  CLIENT
}

enum FinancialTypeEnum {
  EXPENSE
  REVENUE
}

enum FinancialRecurrenceTypeEnum {
  UNIQUE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
