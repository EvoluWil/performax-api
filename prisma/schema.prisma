generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  cpf       String       @unique
  email     String       @unique
  role      UserRoleEnum @default(USER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deleted   Boolean      @default(false)

  session                UserSession?
  credential             UserCredential?
  recoveryPassword       UserRecoveryPassword?
  companyUser            CompanyUserRole[]
  entries                CompanyEntry[]
  entriesResponsible     CompanyEntry[]        @relation("entryResponsible")
  budgets                CompanyBudget[]
  budgetsResponsible     CompanyBudget[]       @relation("budgetResponsible")
  tasksResponsible       CompanyTask[]         @relation("taskResponsible")
  tasksUpdated           CompanyTask[]         @relation("taskUpdatedBy")
  tasks                  CompanyTask[]
  occurrencesResponsible CompanyOccurrence[]   @relation("occurrenceResponsible")
  occurrences            CompanyOccurrence[]
  financials             CompanyFinance[]
  financialsResponsible  CompanyFinance[]      @relation("financeResponsible")
  receivables            CompanyFinanceReceivable[]
  advances               CompanyFinanceAdvance[]
  contracts              CompanyContract[]
  clientsCreated         CompanyClient[]         @relation("clientCreatedBy")
  companies              Company[]

  supervisedBy    CompanyUserRole[] @relation("targetUsers", fields: [supervisedByIds], references: [id])
  supervisedByIds String[]          @default([]) @db.ObjectId

  @@map("user")
}

model UserSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  accessToken  String   @unique
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  @@map("user_session")
}

model UserCredential {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  @@map("user_credential")
}

model UserRecoveryPassword {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String?
  resetToken String?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  @@map("user_recovery_password")
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String   @unique
  description String?
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies  CompanyModule[]
  permission CompanyRolePermission[]

  @@map("module")
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @db.ObjectId

  roles               CompanyRole[]
  modules             CompanyModule[]
  userCompany         CompanyUserRole[]
  wallet              CompanyFinanceWallet?
  clients             CompanyClient[]
  paymentMethods      CompanyFinancePaymentMethod[]
  banks               CompanyFinanceBank[]
  employees           CompanyEmployee[]
  entryTypes          CompanyEntryType[]
  entries             CompanyEntry[]
  budgetTypes         CompanyBudgetType[]
  budgets             CompanyBudget[]
  taskTypes           CompanyTaskType[]
  tasks               CompanyTask[]
  occurrenceTypes     CompanyOccurrenceType[]
  occurrences         CompanyOccurrence[]
  financeType         CompanyFinanceType[]
  financials          CompanyFinance[]
  financeIn           CompanyFinance[]              @relation("companyIn")
  financeCategories   CompanyFinanceCategory[]
  financeSegments     CompanyFinanceSegment[]
  financePayee        CompanyFinancePayee[]
  recurringFinancials CompanyFinanceRecurring[]
  receivables         CompanyFinanceReceivable[]
  advances            CompanyFinanceAdvance[]
  contractTypes       CompanyContractType[]
  contracts           CompanyContract[]
  whiteLabel          CompanyWhiteLabel?

  group   CompanyGroup? @relation(fields: [groupId], references: [id])
  groupId String?       @db.ObjectId

  @@map("company")
}

model CompanyGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies Company[]

  @@map("company_group")
}

model CompanyModule {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@unique([moduleId, companyId])
  @@map("company_module")
}

model CompanyWhiteLabel {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  logo           String?
  logoContrast   String?
  banner         String?
  favicon        String?
  primaryColor   String?
  secondaryColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @unique @db.ObjectId

  @@map("company_white_label")
}

model CompanyRolePermission {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  scope      PermissionScopeEnum @default(SELF)
  permission PermissionEnum      @default(READ)

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String @db.ObjectId

  companyRole   CompanyRole? @relation(fields: [companyRoleId], references: [id])
  companyRoleId String?      @db.ObjectId

  @@map("module_permission")
}

model CompanyRole {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isAdmin     Boolean  @default(false)

  permissions CompanyRolePermission[]
  companyUser CompanyUserRole[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_role")
}

model CompanyUserRole {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  targets   User[]   @relation("targetUsers", fields: [targetIds], references: [id])
  targetIds String[] @default([]) @db.ObjectId

  clients   CompanyClient[] @relation(fields: [clientIds], references: [id])
  clientIds String[]        @default([]) @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  role   CompanyRole? @relation(fields: [roleId], references: [id])
  roleId String?      @db.ObjectId

  @@unique([userId, companyId])
  @@map("company_user")
}

model CompanyClient {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  cnpj      String?
  address   String?
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  createdBy   User?   @relation("clientCreatedBy", fields: [createdById], references: [id])
  createdById String? @db.ObjectId

  employees           CompanyEmployee[]
  entries             CompanyEntry[]
  budgets             CompanyBudget[]
  tasks               CompanyTask[]
  occurrences         CompanyOccurrence[]
  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]
  contracts           CompanyContract[]

  users   CompanyUserRole[] @relation(fields: [userIds], references: [id])
  userIds String[]          @default([]) @db.ObjectId

  @@map("company_client")
}

model CompanyContractType {
  id                       String                   @id @default(auto()) @map("_id") @db.ObjectId
  name                     String
  adjustments              ContractTypeAdjustment[]
  lastAdjustmentPercentage Float?
  lastAdjustmentAt         DateTime?
  deleted                  Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  contracts CompanyContract[]

  @@map("company_contract_type")
}

model CompanyContract {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  value        Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  dueDate      DateTime?
  scope        String?
  attachment   File?
  generatedPdf File?
  active       Boolean   @default(true)
  deleted      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client   CompanyClient @relation(fields: [clientId], references: [id])
  clientId String        @db.ObjectId

  type   CompanyContractType @relation(fields: [typeId], references: [id])
  typeId String              @db.ObjectId

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  recurring   CompanyFinanceRecurring? @relation(fields: [recurringId], references: [id])
  recurringId String?                  @unique @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_contract")
}

model CompanyEmployee {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  cpf     String?
  deleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  entries             CompanyEntry[]
  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]

  @@map("company_employee")
}

model CompanyEntryType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  entries CompanyEntry[]

  @@map("company_entry_type")
}

model CompanyEntry {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  observation String?
  protocol    String          @unique
  value       Int             @default(0)
  date        DateTime        @default(now())
  deleted     Boolean         @default(false)
  status      EntryStatusEnum @default(PENDING)
  approved    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   CompanyEntryType @relation(fields: [typeId], references: [id])
  typeId String           @db.ObjectId

  responsible   User?   @relation("entryResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id])
  employeeId String?          @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("companies_entry")
}

model CompanyBudgetType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  budgets CompanyBudget[]

  @@map("company_budget_type")
}

model CompanyBudget {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  protocol    String   @unique
  title       String
  description String?
  observation String?
  value       Int      @default(0)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status   BudgetStatusEnum @default(PENDING)
  approved Boolean          @default(true)

  items BudgetItem[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   CompanyBudgetType? @relation(fields: [typeId], references: [id])
  typeId String?            @db.ObjectId

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  task      CompanyTask[]
  closeTask CompanyTask[] @relation("closeBudget")

  responsible   User?   @relation("budgetResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_budget")
}

model CompanyOccurrenceType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  occurrences CompanyOccurrence[]

  @@map("company_occurrence_type")
}

model CompanyOccurrence {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  observation String?
  protocol    String               @unique
  date        DateTime
  documents   File[]
  deleted     Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  status           OccurrenceStatusEnum @default(PENDING)
  approved         Boolean              @default(true)
  conclusionNote   String?
  conclusionFiles  File[]
  completedAt      DateTime?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  type   CompanyOccurrenceType? @relation(fields: [typeId], references: [id])
  typeId String?                @db.ObjectId

  responsible   User?   @relation("occurrenceResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_occurrence")
}

model CompanyTaskType {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean @default(false)
  deleted     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  tasks CompanyTask[]

  @@map("company_task_type")
}

model CompanyTask {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  protocol               String         @unique
  title                  String
  description            String?
  internalNote           String?
  deleted                Boolean        @default(false)
  impedimentNote         String?
  conclusionNote         String?
  value                  Int            @default(0)
  status                 TaskStatusEnum @default(PENDING)
  approved               Boolean        @default(true)
  files                  File[]
  conclusionFiles        File[]
  date                   DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  completedAt            DateTime?
  recurrence             String?
  recurrenceMasterId     String?        @db.ObjectId
  recurrenceOriginalDate DateTime?
  recurrenceIsGenerated  Boolean        @default(false)

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  checklist CompanyTaskChecklist?

  type   CompanyTaskType? @relation(fields: [typeId], references: [id])
  typeId String?          @db.ObjectId

  updatedBy   User?   @relation(fields: [updatedById], references: [id], name: "taskUpdatedBy", onDelete: SetNull)
  updatedById String? @db.ObjectId

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String? @db.ObjectId

  budget   CompanyBudget? @relation(fields: [budgetId], references: [id])
  budgetId String?        @db.ObjectId

  closeBudget   CompanyBudget? @relation("closeBudget", fields: [closeBudgetId], references: [id])
  closeBudgetId String?        @db.ObjectId

  responsible   User?   @relation(fields: [responsibleId], references: [id], name: "taskResponsible", onDelete: SetNull)
  responsibleId String? @db.ObjectId

  @@map("company_task")
}

model CompanyTaskChecklist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   CompanyTask? @relation(fields: [taskId], references: [id])
  taskId String?      @unique @db.ObjectId

  modules CompanyTaskChecklistModule[]

  @@map("company_task_checklist")
}

model CompanyTaskChecklistModule {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  checklist   CompanyTaskChecklist @relation(fields: [checklistId], references: [id])
  checklistId String               @db.ObjectId

  items CompanyTaskChecklistItem[]

  @@map("company_task_checklist_module")
}

model CompanyTaskChecklistItem {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  question     String // Ex: "Limpar lentes"
  expectedType ChecklistItemType // Tipo esperado: BOOLEAN, NUMBER, etc.
  valueBoolean Boolean? // Campo preenchido se tipo BOOLEAN
  valueNumber  Float? // Campo preenchido se tipo NUMBER
  valueText    String? // Campo preenchido se tipo TEXT

  module   CompanyTaskChecklistModule @relation(fields: [moduleId], references: [id])
  moduleId String                     @db.ObjectId

  @@map("company_task_checklist_item")
}

model CompanyFinanceType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]
  advances            CompanyFinanceAdvance[]

  @@map("company_finance_type")
}

model CompanyFinance {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  protocol           String            @unique
  value              Int               @default(0)
  tax                Int               @default(0)
  retention          Int               @default(0)
  date               DateTime
  paymentDate        DateTime?
  observation        String?
  status             FinanceStatusEnum @default(PENDING)
  approved           Boolean           @default(true)
  flow               FinanceFlowEnum   @default(IN)
  deleted            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  recurrenceMasterId String?           @db.ObjectId

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   CompanyFinanceType? @relation(fields: [typeId], references: [id])
  typeId String?             @db.ObjectId

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  method   CompanyFinancePaymentMethod @relation(fields: [methodId], references: [id])
  methodId String                      @db.ObjectId

  bank   CompanyFinanceBank @relation(fields: [bankId], references: [id])
  bankId String             @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  companyIn   Company? @relation("companyIn", fields: [companyInId], references: [id])
  companyInId String?  @db.ObjectId

  category   CompanyFinanceCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?                 @db.ObjectId

  payee   CompanyFinancePayee? @relation(fields: [payeeId], references: [id])
  payeeId String?              @db.ObjectId

  segment   CompanyFinanceSegment? @relation(fields: [segmentId], references: [id])
  segmentId String?                @db.ObjectId

  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id])
  employeeId String?          @db.ObjectId

  responsible   User?   @relation("financeResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  linkedFinance   CompanyFinance?  @relation("FinanceLink", fields: [linkedFinanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedFinanceId String?          @db.ObjectId
  linkedBy        CompanyFinance[] @relation("FinanceLink")

  receivable              CompanyFinanceReceivable? @relation("receivableInstallments", fields: [receivableId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivableId            String?                   @db.ObjectId
  receivableInstallment   Int?
  isInstallment           Boolean                   @default(false)

  advance       CompanyFinanceAdvance? @relation("advanceApplications", fields: [advanceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  advanceId     String?                @db.ObjectId
  paidFromAdvance Boolean              @default(false)
  isAdvanceDeposit Boolean             @default(false)

  @@map("company_finance")
}

model CompanyFinanceWallet {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  amount       Int      @default(0)
  initialValue Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique @db.ObjectId

  @@map("company_finance_wallet")
}

model CompanyFinancePaymentMethod {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  company             Company                   @relation(fields: [companyId], references: [id])
  companyId           String                    @db.ObjectId
  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]
  advances            CompanyFinanceAdvance[]

  @@map("company_finance_payment_method")
}

model CompanyFinanceBank {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  company             Company                   @relation(fields: [companyId], references: [id])
  companyId           String                    @db.ObjectId
  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]
  advances            CompanyFinanceAdvance[]

  @@map("company_finance_bank")
}

model CompanyFinanceCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_finance_category")
}

model CompanyFinanceSegment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_finance_segment")
}

model CompanyFinancePayee {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  financials          CompanyFinance[]
  recurringFinancials CompanyFinanceRecurring[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@map("company_finance_payee")
}

model CompanyFinanceRecurring {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String          @default("Sem título")
  description String?
  value       Int             @default(0)
  date        DateTime
  observation String?
  flow        FinanceFlowEnum @default(IN)
  endDate     DateTime?       @default("2100-01-01T00:00:00.000Z")
  recurrence  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastDate  DateTime @default(now())

  type   CompanyFinanceType @relation(fields: [typeId], references: [id])
  typeId String             @db.ObjectId

  client   CompanyClient? @relation(fields: [clientId], references: [id])
  clientId String?        @db.ObjectId

  method   CompanyFinancePaymentMethod @relation(fields: [methodId], references: [id])
  methodId String                      @db.ObjectId

  bank   CompanyFinanceBank @relation(fields: [bankId], references: [id])
  bankId String             @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  category   CompanyFinanceCategory @relation(fields: [categoryId], references: [id])
  categoryId String                 @db.ObjectId

  segment   CompanyFinanceSegment? @relation(fields: [segmentId], references: [id])
  segmentId String?                @db.ObjectId

  payee   CompanyFinancePayee? @relation(fields: [payeeId], references: [id])
  payeeId String?              @db.ObjectId

  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id])
  employeeId String?          @db.ObjectId

  contract   CompanyContract?

  @@map("company_finance_recurring")
}

model CompanyFinanceReceivable {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  protocol         String                @unique
  title            String
  description      String?
  observation      String?
  totalValue       Int
  installmentCount Int
  paidCount        Int                   @default(0)
  flow             FinanceFlowEnum       @default(IN)
  status           ReceivableStatusEnum  @default(OPEN)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  companyId   String  @db.ObjectId

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  installments CompanyFinance[] @relation("receivableInstallments")

  @@map("company_finance_receivables")
}

enum ReceivableStatusEnum {
  OPEN
  PARTIAL
  SETTLED
}

model CompanyFinanceAdvance {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  protocol       String             @unique
  title          String
  description    String?
  observation    String?
  totalValue     Int
  remainingValue Int
  date           DateTime
  status         AdvanceStatusEnum  @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  companyId   String  @db.ObjectId

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  bank   CompanyFinanceBank? @relation(fields: [bankId], references: [id])
  bankId String?             @db.ObjectId

  method   CompanyFinancePaymentMethod? @relation(fields: [methodId], references: [id])
  methodId String?                      @db.ObjectId

  type   CompanyFinanceType? @relation(fields: [typeId], references: [id])
  typeId String?             @db.ObjectId

  applications CompanyFinance[] @relation("advanceApplications")

  @@map("company_finance_advances")
}

enum AdvanceStatusEnum {
  OPEN
  PARTIAL
  SETTLED
}

model AuditLog {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  model     String // "CompanyBudget", "CompanyTask" etc.
  modelId   String?         @db.ObjectId // ID of the model instance being audited
  action    AuditActionEnum // CREATE, UPDATE, DELETE
  data      Json            @default("{}") // JSON data of the change
  userId    String?         @db.ObjectId
  companyId String?         @db.ObjectId
  createdAt DateTime        @default(now())

  @@map("audit_log")
}

model Changelog {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  version     String
  title       String
  description String
  type        ChangelogTypeEnum
  date        DateTime
  deleted     Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("changelog")
}

