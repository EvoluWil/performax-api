generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  cpf              String       @unique
  email            String       @unique
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  active           Boolean      @default(true)
  role             UserRoleEnum @default(USER)
  isRgSeg          Boolean?     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks              Task[]      @relation(name: "user")
  taskUpdates        Task[]      @relation(name: "updatedBy")
  taskCreates        Task[]      @relation(name: "createdBy")
  checklistCreates   Checklist[] @relation(name: "createdBy")
  checklist          Checklist[]
  entriesCreates     Entry[]
  entriesResponsible Entry[]     @relation(name: "entryResponsible")
  budgetsResponsible Budget[]    @relation(name: "budgetResponsible")
  budgets            Budget[]

  coordinates    User[]       @relation("coordination", references: [id], fields: [coordinatesId])
  coordinatesId  String[]     @db.ObjectId
  coordinators   User[]       @relation("coordination", references: [id], fields: [coordinatorsId])
  coordinatorsId String[]     @db.ObjectId
  occurrences    Occurrence[]

  clients    Client[]    @relation(fields: [clientsIds], references: [id])
  clientsIds String[]    @default([]) @db.ObjectId
  financial  Financial[]

  @@map("users")
}

model Task {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  protocol       String?
  title          String
  description    String
  service        String?
  internalNote   String?
  impedimentNote String?

  status TaskStatusEnum @default(OPEN)

  files           File[]
  conclusionFiles File[]

  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  type   TaskType? @relation(fields: [typeId], references: [id])
  typeId String?   @db.ObjectId

  updatedBy   User?   @relation(fields: [updatedById], references: [id], name: "updatedBy", onDelete: SetNull)
  updatedById String? @db.ObjectId

  createdBy   User?   @relation(fields: [updatedById], references: [id], name: "createdBy", onDelete: SetNull)
  createdById String? @db.ObjectId

  budget   Budget? @relation(fields: [budgetId], references: [id])
  budgetId String? @db.ObjectId

  closeBudget   Budget? @relation("closeBudget", fields: [closeBudgetId], references: [id])
  closeBudgetId String? @db.ObjectId

  user   User?   @relation(fields: [userId], references: [id], name: "user", onDelete: Cascade)
  userId String? @db.ObjectId

  @@map("tasks")
}

model TaskType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@map("taskTypes")
}

model Client {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  cnpj    String?
  address String?

  active    Boolean @default(true)
  recurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks              Task[]
  entries            Entry[]
  budgets            Budget[]
  occurrences        Occurrence[]
  gestor             User[]               @relation(fields: [gestorId], references: [id])
  gestorId           String[]             @default([]) @db.ObjectId
  financial          Financial[]
  recurringFinancial RecurringFinancial[]
  employees          Employee[]

  @@map("clients")
}

model Employee {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  cpf      String?
  role     String?
  place    String?
  password String
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  employeeDay        EmployeeDay[]
  entries            Entry[]
  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("employees")
}

model EmployeeDay {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId

  in       EmployeeClock  @relation(name: "in", fields: [inClockId], references: [id], onDelete: Cascade)
  out      EmployeeClock? @relation(name: "out", fields: [outClockId], references: [id], onDelete: Cascade)
  inLunch  EmployeeClock? @relation(name: "inLunch", fields: [inLunchClockId], references: [id], onDelete: Cascade)
  outLunch EmployeeClock? @relation(name: "outLunch", fields: [outLunchClockId], references: [id], onDelete: Cascade)

  inClockId       String  @db.ObjectId
  outClockId      String? @db.ObjectId
  inLunchClockId  String? @db.ObjectId
  outLunchClockId String? @db.ObjectId

  @@map("employeeDays")
}

model EmployeeClock {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ins       EmployeeDay[] @relation(name: "in")
  outs      EmployeeDay[] @relation(name: "out")
  inLunchs  EmployeeDay[] @relation(name: "inLunch")
  outLunchs EmployeeDay[] @relation(name: "outLunch")

  @@map("employeeClocks")
}

model Checklist {
  id         String                  @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  startDate  DateTime
  recurrence ChecklistRecurrenceEnum
  lastCheck  DateTime?
  checks     DateTime[]              @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], name: "createdBy")
  createdById String @db.ObjectId
  user        User   @relation(fields: [userId], references: [id])
  userId      String @db.ObjectId

  @@map("checklists")
}

model Entry {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String          @default("Sem título")
  description String?
  protocol    String          @unique
  value       String
  date        DateTime?       @default(now())
  observation String?
  approved    Boolean
  status      EntryStatusEnum @default(IN_PROGRESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   EntryType? @relation(fields: [typeId], references: [id])
  typeId String?    @db.ObjectId

  responsible   User?   @relation("entryResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.ObjectId

  @@map("entries")
}

model EntryType {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Entry[]

  @@map("entryTypes")
}

model PaymentMethod {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("paymentMethods")
}

model Bank {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("banks")
}

model Company {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial           Financial[]
  recurringFinancial  RecurringFinancial[]
  balance             CompanyBalance?
  financialTransferIn Financial[]          @relation("companyIn")

  @@map("conpanies")
}

model Financial {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String              @default("Sem título")
  description String?
  protocol    String              @unique
  value       String
  tax         String?
  retention   String?
  date        DateTime
  paymentDate DateTime?
  observation String?
  status      FinancialStatusEnum @default(PENDING)
  flow        FinancialFlowEnum   @default(IN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   FinancialType? @relation(fields: [typeId], references: [id])
  typeId String?        @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  method   PaymentMethod @relation(fields: [methodId], references: [id])
  methodId String        @db.ObjectId

  bank   Bank   @relation(fields: [bankId], references: [id])
  bankId String @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  companyIn   Company? @relation("companyIn", fields: [companyInId], references: [id])
  companyInId String?  @db.ObjectId

  category   FinancialCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?            @db.ObjectId

  favored   FinancialFavored? @relation(fields: [favoredId], references: [id])
  favoredId String?           @db.ObjectId

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.ObjectId

  @@map("financial")
}

model FinancialType {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  needApprove Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("financialTypes")
}

model FinancialCategory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("financialCategories")
}

model FinancialFavored {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financial          Financial[]
  recurringFinancial RecurringFinancial[]

  @@map("financialFavoreds")
}

model RecurringFinancial {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  title       String            @default("Sem título")
  description String?
  value       String
  date        DateTime
  observation String?
  flow        FinancialFlowEnum @default(IN)
  endDate     DateTime?         @default("2100-01-01T00:00:00.000Z")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastDate  DateTime @default(now())

  type   FinancialType @relation(fields: [typeId], references: [id])
  typeId String        @db.ObjectId

  client   Client @relation(fields: [clientId], references: [id])
  clientId String @db.ObjectId

  method   PaymentMethod @relation(fields: [methodId], references: [id])
  methodId String        @db.ObjectId

  bank   Bank   @relation(fields: [bankId], references: [id])
  bankId String @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  category   FinancialCategory @relation(fields: [categoryId], references: [id])
  categoryId String            @db.ObjectId

  favored   FinancialFavored? @relation(fields: [favoredId], references: [id])
  favoredId String?           @db.ObjectId

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.ObjectId

  @@map("recurringFinancial")
}

model Budget {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  protocol    String?
  title       String           @default("Sem título")
  description String?
  observation String?
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  allClients  Boolean          @default(false)
  confirmed   Boolean          @default(false)
  status      BudgetStatusEnum @default(PENDING)
  visitedAt   DateTime?

  items BudgetItem[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   BudgetType? @relation(fields: [typeId], references: [id])
  typeId String?     @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  task      Task[]
  closeTask Task[] @relation("closeBudget")

  responsible   User?   @relation("budgetResponsible", fields: [responsibleId], references: [id])
  responsibleId String? @db.ObjectId

  @@map("budgets")
}

model BudgetType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Budget[]

  @@map("budgetTypes")
}

model OccurrenceType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences Occurrence[]

  @@map("OccurrenceTypes")
}

model Occurrence {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  protocol    String   @unique
  resolution  String?
  date        DateTime
  documents   File[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  type   OccurrenceType? @relation(fields: [typeId], references: [id])
  typeId String?         @db.ObjectId

  @@map("occurrences")
}

model CompanyBalance {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  initialValue String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @unique @db.ObjectId

  @@map("companyBalance")
}

type File {
  type String
  url  String
}

enum UserRoleEnum {
  ADMIN
  USER
  GESTOR
  ATTENDANT
  COORDINATOR
  FINANCIAL
}

enum TaskStatusEnum {
  OPEN
  CLOSED
  EXPIRED
  EMERGENCY
  SCHEDULED
  IMPEDED
  IN_PROGRESS
}

enum ChecklistRecurrenceEnum {
  UNIQUE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetStatusEnum {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CHARGED
  PAID
}

enum EntryStatusEnum {
  IN_PROGRESS
  EXPIRED
  IMPEDED
  COMPLETED
}

enum FinancialStatusEnum {
  PENDING
  APPROVED
  PAID
}

enum FinancialFlowEnum {
  IN
  OUT
  TRANSFER
}

type BudgetItem {
  label    String
  value    String
  quantity Int
  type     ItemTypeEnum
}

enum ItemTypeEnum {
  PRODUCT
  SERVICE
}
