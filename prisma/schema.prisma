generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  cpf              String       @unique
  email            String       @unique
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             UserRoleEnum @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks            Task[]      @relation(name: "user")
  taskUpdates      Task[]      @relation(name: "updatedBy")
  taskCreates      Task[]      @relation(name: "createdBy")
  checklistCreates Checklist[] @relation(name: "createdBy")
  checklist        Checklist[]
  entriesCreates   Entry[]
  budgets          Budget[]

  @@map("users")
}

model Task {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  service     String?

  status TaskStatusEnum @default(OPEN)

  files           File[]
  conclusionFiles File[]

  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  type   TaskType? @relation(fields: [typeId], references: [id])
  typeId String?   @db.ObjectId

  updatedBy   User?   @relation(fields: [updatedById], references: [id], name: "updatedBy", onDelete: SetNull)
  updatedById String? @db.ObjectId

  createdBy   User?   @relation(fields: [updatedById], references: [id], name: "createdBy", onDelete: SetNull)
  createdById String? @db.ObjectId

  user   User   @relation(fields: [userId], references: [id], name: "user", onDelete: Cascade)
  userId String @db.ObjectId

  @@map("tasks")
}

model TaskType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@map("taskTypes")
}

model Client {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  cnpj    String?
  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks   Task[]
  entries Entry[]
  budgets Budget[]

  @@map("clients")
}

model Employee {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  cpf      String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeDay EmployeeDay[]

  @@map("employees")
}

model EmployeeDay {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId

  in       EmployeeClock  @relation(name: "in", fields: [inClockId], references: [id], onDelete: Cascade)
  out      EmployeeClock? @relation(name: "out", fields: [outClockId], references: [id], onDelete: Cascade)
  inLunch  EmployeeClock? @relation(name: "inLunch", fields: [inLunchClockId], references: [id], onDelete: Cascade)
  outLunch EmployeeClock? @relation(name: "outLunch", fields: [outLunchClockId], references: [id], onDelete: Cascade)

  inClockId       String  @db.ObjectId
  outClockId      String? @db.ObjectId
  inLunchClockId  String? @db.ObjectId
  outLunchClockId String? @db.ObjectId

  @@map("employeeDays")
}

model EmployeeClock {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ins       EmployeeDay[] @relation(name: "in")
  outs      EmployeeDay[] @relation(name: "out")
  inLunchs  EmployeeDay[] @relation(name: "inLunch")
  outLunchs EmployeeDay[] @relation(name: "outLunch")

  @@map("employeeClocks")
}

model Checklist {
  id         String                  @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  startDate  DateTime
  recurrence ChecklistRecurrenceEnum
  lastCheck  DateTime?
  checks     DateTime[]              @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], name: "createdBy")
  createdById String @db.ObjectId
  user        User   @relation(fields: [userId], references: [id])
  userId      String @db.ObjectId

  @@map("checklists")
}

model Entry {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String  @default("Sem título")
  description String?
  value       String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  allClients Boolean  @default(false)
  confirmed  Boolean  @default(false)

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   EntryType? @relation(fields: [typeId], references: [id])
  typeId String?    @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  @@map("entries")
}

model EntryType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Entry[]

  @@map("entryTypes")
}

model Budget {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       String           @default("Sem título")
  description String?
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  allClients  Boolean          @default(false)
  confirmed   Boolean          @default(false)
  status      BudgetStatusEnum @default(PENDDING)

  items BudgetItem[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  type   BudgetType? @relation(fields: [typeId], references: [id])
  typeId String?     @db.ObjectId

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String? @db.ObjectId

  @@map("budgets")
}

model BudgetItem {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  value String

  budget   Budget @relation(fields: [budgetId], references: [id])
  budgetId String @db.ObjectId

  @@map("budgetItems")
}

model BudgetType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Budget[]

  @@map("budgetTypes")
}

type File {
  type String
  url  String
}

enum UserRoleEnum {
  ADMIN
  USER
  GESTOR
  ATTENDANT
}

enum TaskStatusEnum {
  OPEN
  CLOSED
  EXPIRED
  EMERGENCY
  SCHENDULED
  IMPEDED
}

enum ChecklistRecurrenceEnum {
  UNIQUE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetStatusEnum {
  PENDDING
  APPROVED
  REJECTED
  COMPLETED
}
